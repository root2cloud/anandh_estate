<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ============================================== -->
        <!-- AGENT RECORD RULES (Existing - Kept Intact)    -->
        <!-- ============================================== -->

        <!-- Portal Agent: See only their own agent record -->
        <record id="agent_portal_rule_own_agent" model="ir.rule">
            <field name="name">Portal Agent: Own Agent Record Only</field>
            <field name="model_id" ref="model_real_estate_agent"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal Agent: See only their own properties -->
        <record id="agent_portal_rule_own_properties" model="ir.rule">
            <field name="name">Portal Agent: Own Properties Only</field>
            <field name="model_id" ref="model_property_property"/>
            <field name="domain_force">[('agent_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Public Users: Cannot see agents directly -->
        <record id="agent_public_rule_no_access" model="ir.rule">
            <field name="name">Public: Limited Agent Access</field>
            <field name="model_id" ref="model_real_estate_agent"/>
            <field name="domain_force">[('is_active', '=', True)]</field>
            <field name="groups" eval="[(4, ref('base.group_public'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ============================================== -->
        <!-- CUSTOMER RECORD RULES (New & Updated)          -->
        <!-- ============================================== -->

        <!-- Customer Portal: See only their own Property Registrations -->
        <record id="customer_portal_rule_own_property_registrations" model="ir.rule">
            <field name="name">Customer Portal: Own Property Registrations Only</field>
            <field name="model_id" ref="model_property_registration"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Customer Portal: See only their own Customer Registrations -->
        <record id="customer_portal_rule_own_customer_registrations" model="ir.rule">
            <field name="name">Customer Portal: Own Customer Registrations Only</field>
            <field name="model_id" ref="model_customer_registration"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Customer Portal: See only their own partner profile -->
        <record id="customer_portal_rule_own_partner" model="ir.rule">
            <field name="name">Customer Portal: Own Profile Only</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>