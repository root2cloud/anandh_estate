<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== SEQUENCE ==================== -->
    <data noupdate="1">
        <record id="sequence_flier_registration" model="ir.sequence">
            <field name="name">Flyer Registration Sequence</field>
            <field name="code">flier.registration</field>
            <field name="prefix">FLY-REG-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
    </data>

    <!-- ==================== LIST VIEW ==================== -->
    <record id="view_flier_registration_list" model="ir.ui.view">
        <field name="name">flier.registration.list</field>
        <field name="model">flier.registration</field>
        <field name="arch" type="xml">
            <list string="Flyer Property Registrations"
                  decoration-info="status=='new'"
                  decoration-warning="status=='contacted'"
                  decoration-muted="status=='closed'">
                <field name="name"/>
                <field name="submission_date"/>
                <field name="property_id"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="bid_amount" sum="Total bids"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="city" optional="hide"/>
                <field name="state_id" optional="hide"/>
                <field name="zip_code" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-info="status=='new'"
                       decoration-warning="status=='contacted'"
                       decoration-success="status=='closed'"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_flier_registration_form" model="ir.ui.view">
        <field name="name">flier.registration.form</field>
        <field name="model">flier.registration</field>
        <field name="arch" type="xml">
            <form string="Flyer Property Registration">
                <header>
                    <button name="action_mark_contacted" type="object" string="Mark Contacted"
                            class="btn-primary" invisible="status != 'new'"/>
                    <button name="action_mark_closed" type="object" string="Close"
                            class="btn-primary" invisible="status != 'contacted'"/>
                    <button name="action_reset_new" type="object" string="Set to New"
                            invisible="status == 'new'"/>
                    <field name="status" widget="statusbar" statusbar_visible="new,contacted,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_property" type="object" class="oe_stat_button" icon="fa-home">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Property</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Registered For">
                            <field name="property_id"/>
                            <field name="property_price"/>
                            <field name="bid_amount"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="source"/>
                            <field name="submission_date"/>
                        </group>
                        <group string="Customer">
                            <field name="customer_name"/>
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <group string="Address">
                        <group>
                            <field name="address"/>
                            <field name="city"/>
                        </group>
                        <group>
                            <field name="state_id"/>
                            <field name="zip_code"/>
                        </group>
                    </group>
                    <group string="Follow-up">
                        <field name="customer_registration_id"/>
                        <field name="note" placeholder="Internal notes about this lead..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_flier_registration_search" model="ir.ui.view">
        <field name="name">flier.registration.search</field>
        <field name="model">flier.registration</field>
        <field name="arch" type="xml">
            <search string="Flyer Property Registrations">
                <field name="name"/>
                <field name="customer_name"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="property_id"/>
                <field name="city"/>
                <filter string="With a bid" name="f_bid" domain="[('bid_amount', '&gt;', 0)]"/>
                <separator/>
                <filter string="New" name="f_new" domain="[('status', '=', 'new')]"/>
                <filter string="Contacted" name="f_contacted" domain="[('status', '=', 'contacted')]"/>
                <filter string="Closed" name="f_closed" domain="[('status', '=', 'closed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Property" name="g_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Status" name="g_status" context="{'group_by': 'status'}"/>
                    <filter string="State" name="g_state" context="{'group_by': 'state_id'}"/>
                    <filter string="Submitted Date" name="g_date" context="{'group_by': 'submission_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_flier_registration" model="ir.actions.act_window">
        <field name="name">Flyer Property Registrations</field>
        <field name="res_model">flier.registration</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_flier_registration_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No flyer registrations yet!
            </p>
            <p>
                Registrations submitted from a property flyer (or the page opened by its QR code) appear here.
            </p>
        </field>
    </record>

    <!-- ==================== MENU ==================== -->
    <menuitem id="menu_flier_registration"
              name="Flyer Property Registrations"
              parent="menu_real_estate_root"
              action="action_flier_registration"
              sequence="35"/>

</odoo>