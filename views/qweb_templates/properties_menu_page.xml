<odoo>
    <template id="property_listing_template" name="Luxury Property Listing Page (Black + Gold)">
        <t t-call="website.layout">
        <!-- 💎 Luxury Black + Gold CSS (in <head> so the page never shows unstyled while loading) -->
        <t t-set="head">
            <style>
            /* ==============================
               💎 Luxury Black + Gold Theme
            ============================== */
            :root {
                --bg: #070A0F;                 /* Deep Black */
                --surface: #0D111A;            /* Card base */
                --surface-2: #111827;          /* Slightly lighter */
                --text: #F8FAFC;               /* White */
                --muted: rgba(248, 250, 252, 0.65);

                /* Gold (Single Button Color) */
                --gold: #D4AF37;
                --gold-dark: #B88B1E;
                --gold-soft: rgba(212, 175, 55, 0.12);

                --border: rgba(212, 175, 55, 0.18);

                --shadow-sm: 0 10px 25px rgba(0,0,0,0.55);
                --shadow-md: 0 20px 50px rgba(0,0,0,0.70);

                --radius-lg: 20px;
                --radius-md: 16px;
                --radius-sm: 12px;
            }

            .main-container {
                background: var(--bg);
                font-family: "Poppins", "Inter", system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
                color: var(--text);
                padding: 0;
            }

            /* ==============================
               🌆 HERO SECTION
            ============================== */
            .hero-section {
                position: relative;
                padding: 4.5rem 1rem 5.2rem;
                text-align: center;
                overflow: hidden;

                background:
                    radial-gradient(circle at 20% 15%, rgba(212,175,55,0.20), transparent 60%),
                    radial-gradient(circle at 85% 35%, rgba(212,175,55,0.10), transparent 55%),
                    linear-gradient(135deg, #05070B, #0B1220);
            }

            .hero-overlay {
                position: absolute;
                inset: 0;
                background:
                    url("https://cdn.pixabay.com/photo/2016/11/18/14/42/architecture-1836070_1280.jpg")
                    center/cover no-repeat;
                opacity: 0.10;
                filter: saturate(0.9) contrast(1.1);
                transform: scale(1.06);
            }

            .hero-content {
                position: relative;
                z-index: 2;
                max-width: 950px;
                margin: 0 auto;
            }

            .hero-content h1 {
                font-size: clamp(2rem, 3.2vw, 3.1rem);
                font-weight: 900;
                line-height: 1.15;
                margin-bottom: 0.85rem;
                letter-spacing: 0.2px;
            }

            .hero-content p {
                font-size: clamp(1rem, 1.2vw, 1.15rem);
                line-height: 1.75;
                color: rgba(248, 250, 252, 0.82);
                margin-bottom: 1.85rem;
            }

            /* Gold button (single color) */
            .explore-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                background: var(--gold);
                color: #0B0F17;
                padding: 0.82rem 1.8rem;
                border-radius: 999px;
                font-weight: 850;
                text-decoration: none;
                box-shadow: 0 18px 38px rgba(212,175,55,0.18);
                transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
            }

            .explore-btn:hover {
                background: var(--gold-dark);
                transform: translateY(-2px);
                box-shadow: 0 24px 45px rgba(212,175,55,0.22);
                color: #0B0F17;
            }

            /* ==============================
               🎯 INTEREST CONTEXT BANNER
            ============================== */
            .interest-context-banner {
                max-width: 1100px;
                /* ⭐ FIX: this now does the "float up over the hero" pull
                   that the search card normally does, since the banner
                   sits first when it's shown. This keeps the same visual
                   effect without the search card overlapping it. */
                margin: -2.4rem auto 0;
                padding: 0 1rem;
                position: relative;
                z-index: 6;
            }

            .interest-context-inner {
                display: flex;
                align-items: center;
                gap: 0.75rem;
                background: rgba(212,175,55,0.10);
                border: 1px solid rgba(212,175,55,0.30);
                border-radius: var(--radius-lg);
                padding: 0.85rem 1.2rem;
                color: #F8FAFC;
                flex-wrap: wrap;
            }

            .interest-context-icon {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 34px;
                height: 34px;
                border-radius: 50%;
                background: rgba(212,175,55,0.20);
                color: var(--gold);
                flex-shrink: 0;
            }

            .interest-context-text {
                flex: 1;
                font-size: 0.95rem;
            }

            .interest-context-clear {
                color: rgba(248,250,252,0.70);
                text-decoration: none;
                font-size: 0.85rem;
                font-weight: 600;
                white-space: nowrap;
            }

            .interest-context-clear:hover {
                color: var(--gold);
            }

            /* ==============================
               🔍 SEARCH SECTION
            ============================== */
            .search-section {
                margin-top: -2.4rem;
                padding: 0 1rem;
                position: relative;
                z-index: 5;
            }

            /* ⭐ FIX: when the interest banner is shown above, the search
               card should sit normally below it (not pulled up over it). */
            .search-section-after-banner {
                margin-top: 1.25rem;
            }

            .search-card {
                max-width: 1100px;
                margin: 0 auto;
                background: rgba(13, 17, 26, 0.92);
                backdrop-filter: blur(10px);
                border: 1px solid rgba(212,175,55,0.20);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-sm);
                padding: 1.25rem 1.25rem 1rem;
            }

            .search-form {
                display: grid;
                grid-template-columns: 1.3fr 1fr 1fr auto;
                gap: 0.9rem;
                align-items: end;
            }

            .input-group label {
                display: block;
                font-size: 0.78rem;
                font-weight: 700;
                color: rgba(248,250,252,0.70);
                margin-bottom: 0.35rem;
                letter-spacing: 0.2px;
            }

            .search-form input {
                width: 100%;
                padding: 0.78rem 0.95rem;
                border-radius: 14px;
                border: 1px solid rgba(255,255,255,0.10);
                background: rgba(255,255,255,0.04);
                color: var(--text);
                font-size: 0.95rem;
                outline: none;
                transition: border 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
            }

            .search-form input::placeholder {
                color: rgba(248,250,252,0.45);
            }

            .search-form input:focus {
                border-color: rgba(212,175,55,0.55);
                background: rgba(255,255,255,0.06);
                box-shadow: 0 0 0 4px rgba(212,175,55,0.10);
            }

            /* Gold Search button */
            .search-btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 0.45rem;
                background: var(--gold);
                color: #0B0F17;
                border: none;
                border-radius: 14px;
                padding: 0.85rem 1.25rem;
                font-weight: 900;
                cursor: pointer;
                transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
                box-shadow: 0 18px 35px rgba(212,175,55,0.16);
            }

            .search-btn:hover {
                background: var(--gold-dark);
                transform: translateY(-2px);
                box-shadow: 0 24px 44px rgba(212,175,55,0.22);
            }

            .back-wrap {
                margin-top: 0.85rem;
                display: flex;
                justify-content: flex-start;
            }

            .back-btn {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                text-decoration: none;
                font-weight: 700;
                font-size: 0.95rem;
                color: rgba(248,250,252,0.80);
                padding: 0.55rem 0.95rem;
                border-radius: 14px;
                border: 1px solid rgba(255,255,255,0.10);
                background: rgba(255,255,255,0.04);
                transition: transform 0.25s ease, background 0.25s ease;
            }

            .back-btn:hover {
                background: rgba(212,175,55,0.08);
                transform: translateY(-1px);
                color: rgba(248,250,252,0.92);
            }

            /* ==============================
               🏘 PROPERTY SECTION
            ============================== */
            .property-section {
                padding: 2rem 1rem 3.4rem;
            }

            .property-container {
                max-width: 1200px;
                margin: 0 auto;
            }

            .property-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 1.25rem;
                margin-top: 1rem;
            }

            .property-card {
                background: linear-gradient(180deg, rgba(17,24,39,0.92), rgba(13,17,26,0.92));
                border-radius: var(--radius-lg);
                border: 1px solid rgba(255,255,255,0.08);
                box-shadow: var(--shadow-sm);
                overflow: hidden;
                transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
                display: flex;
                flex-direction: column;
            }

            .property-card:hover {
                transform: translateY(-8px);
                box-shadow: var(--shadow-md);
                border-color: rgba(212,175,55,0.25);
            }

            /* Image wrapper */
            .property-image-wrapper {
                position: relative;
                overflow: hidden;
            }

            .property-image {
                height: 180px;
                overflow: hidden;
                background: #0B0F17;
            }

            .property-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.45s ease, filter 0.35s ease;
            }

            .property-card:hover .property-image img {
                transform: scale(1.08);
                filter: contrast(1.05) brightness(1.05);
            }

            /* Luxury subtle glow on image */
            .image-glow {
                position: absolute;
                inset: 0;
                background: linear-gradient(
                    180deg,
                    rgba(0,0,0,0.10) 0%,
                    rgba(0,0,0,0.25) 55%,
                    rgba(0,0,0,0.55) 100%
                );
                pointer-events: none;
            }

            /* Status ribbon */
            .status-ribbon-wrapper {
                position: absolute;
                top: 12px;
                right: 12px;
                z-index: 10;
            }

            .status-ribbon {
                display: inline-flex;
                align-items: center;
                gap: 0.35rem;
                padding: 0.45rem 0.75rem;
                font-size: 11px;
                font-weight: 900;
                letter-spacing: 0.9px;
                color: #0B0F17;
                border-radius: 999px;
                background: var(--gold);
                box-shadow: 0 12px 25px rgba(0,0,0,0.35);
                text-transform: uppercase;
            }

            /* Keep statuses but still luxury */
            .ribbon-available { background: #D4AF37; color: #0B0F17; }
            .ribbon-sold { background: #DC2626; color: #fff; }
            .ribbon-rented { background: #0284C7; color: #fff; }

            /* Property Info */
            .property-info {
                padding: 1rem 1rem 1.1rem;
                display: flex;
                flex-direction: column;
                flex: 1;
            }

            .property-name {
                font-size: 1.05rem;
                font-weight: 850;
                line-height: 1.25;
                margin: 0 0 0.35rem;
                color: rgba(248,250,252,0.95);
            }

            .category {
                font-size: 0.86rem;
                color: rgba(212,175,55,0.92);
                margin: 0;
                display: flex;
                gap: 0.45rem;
                align-items: center;
                font-weight: 700;
            }

            .property-rating {
                margin: 0.3rem 0 0;
                font-size: 0.82rem;
            }
            .property-rating .fa-star { color: #f5a623; }
            .property-rating .fa-star-o { color: rgba(248,250,252,0.35); }

            .property-price {
                display: flex;
                align-items: baseline;
                gap: 0.35rem;
                margin: 0.35rem 0 0.75rem;
            }

            .currency {
                font-size: 0.95rem;
                color: rgba(212,175,55,0.85);
                font-weight: 800;
            }

            .amount {
                font-size: 1.25rem;
                font-weight: 950;
                color: rgba(248,250,252,0.95);
                letter-spacing: 0.2px;
            }

            /* Meta block */
            .meta {
                display: grid;
                gap: 0.45rem;
                padding: 0.75rem 0.8rem;
                border-radius: 16px;
                background: rgba(255,255,255,0.04);
                border: 1px solid rgba(255,255,255,0.08);
                margin-bottom: 0.85rem;
            }

            .meta-row {
                display: flex;
                justify-content: space-between;
                gap: 0.75rem;
                font-size: 0.86rem;
                line-height: 1.35;
            }

            .meta-label {
                color: rgba(248,250,252,0.55);
                font-weight: 650;
            }

            .meta-value {
                color: rgba(248,250,252,0.88);
                font-weight: 800;
                text-align: right;
            }

            .location {
                font-size: 0.9rem;
                color: rgba(248,250,252,0.65);
                display: flex;
                align-items: center;
                gap: 0.45rem;
                margin: 0 0 1rem;
            }

            /* Gold CTA */
            .view-btn {
                margin-top: auto;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 100%;
                background: var(--gold);
                color: #0B0F17;
                padding: 0.82rem 1rem;
                border-radius: 16px;
                text-decoration: none;
                font-weight: 950;
                font-size: 0.92rem;
                transition: transform 0.25s ease, background 0.25s ease, box-shadow 0.25s ease;
                box-shadow: 0 18px 35px rgba(212,175,55,0.14);
            }

            .view-btn:hover {
                background: var(--gold-dark);
                transform: translateY(-2px);
                box-shadow: 0 24px 45px rgba(212,175,55,0.20);
                color: #0B0F17;
            }

            /* ==============================
               Empty State
            ============================== */
            .empty-state {
                background: rgba(13, 17, 26, 0.92);
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: var(--radius-lg);
                padding: 3rem 1.25rem;
                text-align: center;
                box-shadow: var(--shadow-sm);
                margin-top: 1.2rem;
            }

            .empty-icon {
                width: 62px;
                height: 62px;
                margin: 0 auto 0.85rem;
                border-radius: 18px;
                display: grid;
                place-items: center;
                background: rgba(212,175,55,0.12);
                color: rgba(212,175,55,0.95);
                font-size: 1.6rem;
            }

            .no-results {
                margin: 0;
                font-size: 1.15rem;
                font-weight: 950;
                color: rgba(248,250,252,0.92);
            }

            .no-results-sub {
                margin: 0.45rem 0 0;
                font-size: 0.95rem;
                color: rgba(248,250,252,0.62);
            }

            /* ==============================
               ✨ Animation
            ============================== */
            .fade-in {
                opacity: 0;
                transform: translateY(18px);
                animation: fadeInUp 0.7s ease forwards;
            }

            @keyframes fadeInUp {
                to { opacity: 1; transform: translateY(0); }
            }

            /* ==============================
               📱 Responsive
            ============================== */
            @media (max-width: 1200px) {
                .property-grid { grid-template-columns: repeat(3, 1fr); }
            }

            @media (max-width: 992px) {
                .search-form { grid-template-columns: 1fr 1fr; }
                .search-btn-wrap { grid-column: 1 / -1; }
                .search-btn { width: 100%; }
                .property-grid { grid-template-columns: repeat(2, 1fr); }
            }

            @media (max-width: 600px) {
                .hero-section { padding: 3.4rem 1rem 4.2rem; }
                .search-form { grid-template-columns: 1fr; }
                .property-grid { grid-template-columns: 1fr; }
                .property-image { height: 220px; }
            }

            /* ==============================
               ➕ Add a Property button + pop-up form
            ============================== */
            .back-wrap { flex-wrap: wrap; gap: 0.75rem; }
            .add-prop-btn {
                display: inline-flex; align-items: center; gap: 0.5rem; cursor: pointer;
                font-weight: 900; font-size: 0.95rem; color: #0B0F17;
                background: var(--gold); border: none; border-radius: 14px;
                padding: 0.6rem 1.1rem;
                box-shadow: 0 18px 35px rgba(212,175,55,0.16);
                transition: transform 0.25s ease, background 0.25s ease;
            }
            .add-prop-btn:hover { transform: translateY(-2px); background: var(--gold-dark); }

            .apm-overlay {
                display: none; position: fixed; inset: 0; z-index: 2000;
                background: rgba(0,0,0,0.78); overflow-y: auto; padding: 32px 14px;
            }
            .apm-overlay.apm-open { display: block; }
            body.apm-lock { overflow: hidden; }
            .apm-panel {
                position: relative; max-width: 1000px; margin: 0 auto;
                background: var(--surface); color: var(--text);
                border: 1px solid var(--border); border-radius: var(--radius-lg);
                box-shadow: var(--shadow-md); padding: 34px 36px 30px;
            }
            .apm-close {
                position: absolute; top: 14px; right: 16px; width: 38px; height: 38px;
                border-radius: 50%; border: 1px solid var(--border); background: transparent;
                color: var(--text); font-size: 18px; cursor: pointer;
            }
            .apm-close:hover { background: var(--gold-soft); }
            .apm-head { text-align: center; margin-bottom: 26px; }
            .apm-head h2 {
                font-family: 'DM Serif Display', serif; font-weight: 400;
                font-size: clamp(28px, 3.6vw, 44px); color: var(--text); margin: 0 0 10px; line-height: 1.2;
            }
            .apm-head p { color: var(--muted); margin: 0; font-size: 15px; }
            .apm-section {
                font-weight: 800; font-size: 13px; letter-spacing: 0.5px; text-transform: uppercase;
                color: var(--gold); margin: 24px 0 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border);
            }
            .apm-section:first-of-type { margin-top: 0; }
            .apm-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px 18px; }
            .apm-field.apm-full { grid-column: 1 / -1; }
            .apm-field label { display: block; font-size: 13px; font-weight: 700; color: rgba(248,250,252,0.85); margin-bottom: 6px; }
            .apm-field label .apm-req { color: #f87171; }
            .apm-field input[type="text"], .apm-field input[type="tel"], .apm-field input[type="email"],
            .apm-field input[type="number"], .apm-field select {
                width: 100%; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 12px 14px;
                font-size: 14px; color: var(--text); background: var(--surface-2); outline: none;
            }
            .apm-field input::placeholder { color: rgba(248,250,252,0.35); }
            .apm-field input:focus, .apm-field select:focus { border-color: var(--gold); box-shadow: 0 0 0 3px var(--gold-soft); }
            .apm-field small { display: block; margin-top: 5px; font-size: 11.5px; color: var(--muted); }
            /* Title is typed in the same serif font it is displayed in */
            .apm-field input.apm-title-input {
                font-family: 'Playfair Display', 'DM Serif Display', serif; font-weight: 800;
                font-size: clamp(22px, 2.4vw, 30px); padding: 12px 16px;
            }
            .apm-field input[type="file"] {
                width: 100%; border: 2px dashed var(--border); border-radius: 12px; padding: 18px;
                background: var(--surface-2); font-size: 14px; color: var(--text); cursor: pointer;
            }
            .apm-previews { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }
            .apm-prev { position: relative; width: 96px; height: 96px; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); }
            .apm-prev img { width: 100%; height: 100%; object-fit: cover; display: block; }
            .apm-prev span {
                position: absolute; left: 0; right: 0; bottom: 0; text-align: center; font-size: 10px; font-weight: 800;
                background: rgba(0,0,0,0.75); color: #fff; padding: 2px 0;
            }
            .apm-submit-row { margin-top: 28px; text-align: center; }
            .apm-submit {
                display: inline-flex; align-items: center; gap: 10px; border: none; cursor: pointer;
                padding: 15px 42px; border-radius: 14px; font-weight: 900; font-size: 15px;
                background: var(--gold); color: #0B0F17; box-shadow: 0 18px 35px rgba(212,175,55,0.16);
                transition: transform 0.25s ease, background 0.25s ease;
            }
            .apm-submit:hover { transform: translateY(-2px); background: var(--gold-dark); }
            .apm-submit:disabled { opacity: 0.7; cursor: wait; transform: none; }
            .apm-note { margin: 14px 0 0; font-size: 12.5px; color: var(--muted); }
            @media (max-width: 992px) { .apm-grid { grid-template-columns: repeat(2, 1fr); } }
            @media (max-width: 600px) {
                .apm-grid { grid-template-columns: 1fr; }
                .apm-panel { padding: 28px 18px 24px; }
            }
        </style>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&amp;family=Playfair+Display:wght@800&amp;display=swap"/>
        </t>
        <main class="main-container">

            <!-- 🏡 Hero Section -->
            <section class="hero-section">
                <div class="hero-overlay"/>
                <div class="hero-content">
                    <h1>Find Your Dream Property</h1>
                    <p>Luxury homes, villas, and premium plots — curated just for you.</p>
                    <a href="#properties" class="explore-btn">Explore Now</a>
                </div>
            </section>

            <!-- 🎯 "Interested In" Context Banner -->
            <!-- Shown when the customer arrived here from the Customer
                 Dashboard "Add New Property" chooser after picking
                 Buying / Renting / Investment instead of Selling. -->
            <t t-if="interested_in and interested_in != 'sell'">
                <section class="interest-context-banner">
                    <div class="interest-context-inner">
                        <span class="interest-context-icon">
                            <i t-attf-class="fa {{'fa-shopping-cart' if interested_in == 'buy' else ('fa-key' if interested_in == 'rent' else 'fa-line-chart')}}"/>
                        </span>
                        <span class="interest-context-text">
                            Showing properties for
                            <strong t-esc="{'buy': 'Buying', 'rent': 'Renting', 'invest': 'Investment'}.get(interested_in, 'You')"/>
                            <t t-if="exclude_own"> — your own listed properties are excluded.</t>
                        </span>
                        <a href="/properties" class="interest-context-clear">
                            <i class="fa fa-times me-1"/> Clear
                        </a>
                    </div>
                </section>
            </t>

            <!-- 🔍 Search Section -->
            <!-- ⭐ FIX: the search card normally has a negative top-margin so
                 it "floats up" over the hero section. When the banner above
                 is present, that same negative margin pulled the search
                 card up over the banner text and hid it. Now the pull-up
                 only happens when the banner is NOT there; the banner
                 itself gets the pull-up treatment instead, so there's
                 never any overlap either way. -->
            <section t-attf-class="search-section #{'search-section-after-banner' if interested_in and interested_in != 'sell' else ''}">
                <div class="search-card">
                    <form method="get" action="/properties" class="search-form">

                        <!-- Preserve the "Interested In" context across searches -->
                        <input type="hidden" name="interested_in" t-att-value="interested_in"/>
                        <input type="hidden" name="exclude_own" t-att-value="exclude_own"/>

                        <div class="input-group">
                            <label>Search</label>
                            <input type="text" name="search" placeholder="Name, Location, ZIP" t-att-value="search"/>
                        </div>

                        <div class="input-group">
                            <label>City</label>
                            <input type="text" name="city" placeholder="Enter city" t-att-value="city"/>
                        </div>

                        <div class="input-group">
                            <label>ZIP</label>
                            <input type="text" name="zip_code" placeholder="Enter ZIP" t-att-value="zip_code"/>
                        </div>

                        <div class="input-group">
                            <label>Rating</label>
                            <select name="rating">
                                <option value="" t-att-selected="'selected' if not rating else None">Any Rating</option>
                                <option value="5" t-att-selected="'selected' if rating=='5' else None">5 Stars</option>
                                <option value="4" t-att-selected="'selected' if rating=='4' else None">4 Stars &amp; Up</option>
                                <option value="3" t-att-selected="'selected' if rating=='3' else None">3 Stars &amp; Up</option>
                                <option value="2" t-att-selected="'selected' if rating=='2' else None">2 Stars &amp; Up</option>
                                <option value="1" t-att-selected="'selected' if rating=='1' else None">1 Star &amp; Up</option>
                            </select>
                        </div>

                        <div class="search-btn-wrap">
                            <button type="submit" class="search-btn">
                                <i class="fa fa-search me-1"></i>
                                Search
                            </button>
                        </div>
                    </form>

                    <div class="back-wrap">
                        <a href="/" class="back-btn">
                            <i class="fa fa-arrow-left"/>
                            Back to Home Page
                        </a>
                        <button type="button" class="add-prop-btn" id="openAddProperty">
                            <i class="fa fa-plus"/>
                            Add a Property
                        </button>
                    </div>
                </div>
            </section>

            <!-- 🏘 Property Listing Section -->
            <section id="properties" class="property-section">
                <div class="property-container">

                    <t t-if="properties">
                        <div class="property-grid">
                            <t t-foreach="properties" t-as="prop">
                                <article class="property-card fade-in">

                                    <!-- ⭐ Property Image with STATUS RIBBON -->
                                    <div class="property-image-wrapper">
                                        <div class="property-image">
                                            <img t-if="prop['image_url']" t-att-src="prop['image_url']" alt="Property Image" loading="lazy" decoding="async"/>
                                            <img t-else="" src="/web/static/img/placeholder.png" alt="No Image"/>
                                        </div>

                                        <!-- ⭐ STATUS RIBBON -->
                                        <div class="status-ribbon-wrapper">
                                            <t t-if="prop.get('status') == 'available'">
                                                <span class="status-ribbon ribbon-available">
                                                    <i class="fa fa-check-circle"></i> AVAILABLE
                                                </span>
                                            </t>

                                            <t t-elif="prop.get('status') == 'sold'">
                                                <span class="status-ribbon ribbon-sold">
                                                    <i class="fa fa-tag"></i> SOLD
                                                </span>
                                            </t>

                                            <t t-elif="prop.get('status') == 'rented'">
                                                <span class="status-ribbon ribbon-rented">
                                                    <i class="fa fa-key"></i> RENTED
                                                </span>
                                            </t>
                                        </div>

                                        <!-- Luxury Image Overlay -->
                                        <div class="image-glow"/>
                                    </div>

                                    <!-- Property Info -->
                                    <div class="property-info">
                                        <div class="property-top">
                                            <h3 class="property-name" t-esc="prop['name']"/>
                                            <p class="category">
                                                <i class="fa fa-tags"></i>
                                                <t t-esc="prop['category']"/>
                                            </p>
                                            <div class="property-rating" t-raw="prop['rating_html']"/>
                                        </div>

                                        <div class="property-price">
                                            <span class="currency">₹</span>
                                            <span class="amount">
                                                <t t-esc="prop['price']"/>
                                            </span>
                                        </div>

                                        <div class="meta">
                                            <div class="meta-row">
                                                <span class="meta-label">Plot Area</span>
                                                <span class="meta-value">
                                                    <t t-esc="prop['plot_area']"/> sq.ft
                                                </span>
                                            </div>

                                            <div class="meta-row">
                                                <span class="meta-label">Price / Sq.Ft</span>
                                                <span class="meta-value">
                                                    ₹ <t t-esc="prop['price_per_sqft']"/>
                                                </span>
                                            </div>
                                        </div>

                                        <p class="location">
                                            <i class="fa fa-map-marker-alt"></i>
                                            <t t-esc="prop['city']"/> - <t t-esc="prop['zip_code']"/>
                                        </p>

                                        <a t-att-href="'/property/' + str(prop['id'])" class="view-btn">
                                            View Details
                                            <i class="fa fa-arrow-right ms-1"></i>
                                        </a>
                                    </div>

                                </article>
                            </t>
                        </div>
                    </t>

                    <t t-if="not properties or not len(properties)">
                        <div class="empty-state">
                            <div class="empty-icon">
                                <i class="fa fa-home"></i>
                            </div>
                            <p class="no-results">No properties found matching your criteria.</p>
                            <p class="no-results-sub">Try adjusting your search filters and search again.</p>
                        </div>
                    </t>

                </div>
            </section>


            <!-- ➕ ADD A PROPERTY pop-up (opens from the "Add a Property" button above).
                 Same fields as the customer property form + the new Title field. -->
            <div class="apm-overlay" id="addPropertyModal" aria-hidden="true">
                <div class="apm-panel" role="dialog" aria-modal="true" aria-labelledby="apmTitle">
                    <button type="button" class="apm-close" id="apmClose" aria-label="Close">
                        <i class="fa fa-times"/>
                    </button>

                    <div class="apm-head">
                        <h2 id="apmTitle">Add a Property</h2>
                        <p>Submit your property details. Our team reviews every listing before it goes live.</p>
                    </div>

                    <form action="/property/submit" method="post" enctype="multipart/form-data"
                          id="apmForm" autocomplete="off">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <input type="hidden" name="add_property_popup" value="1"/>

                        <div class="apm-section">Property Details</div>
                        <div class="apm-grid">
                            <div class="apm-field apm-full">
                                <label>Title <span class="apm-req">*</span></label>
                                <input type="text" name="listing_title" class="apm-title-input"
                                       maxlength="80" required="required"
                                       placeholder="e.g., A Legacy of Luxury Living"/>
                                <small>This headline is shown on your property card on the home page.</small>
                            </div>
                            <div class="apm-field">
                                <label>Property Name <span class="apm-req">*</span></label>
                                <input type="text" name="property_name" placeholder="e.g., Skyline Luxury Apartment" required="required"/>
                            </div>
                            <div class="apm-field">
                                <label>Property Category <span class="apm-req">*</span></label>
                                <select name="category" required="required">
                                    <option value="">Choose category type</option>
                                    <option value="residential">Residential</option>
                                    <option value="commercial">Commercial</option>
                                    <option value="agricultural">Agricultural</option>
                                </select>
                            </div>
                            <div class="apm-field">
                                <label>Built-up Area (sq. yards) <span class="apm-req">*</span></label>
                                <input type="number" name="sq_yards" min="0" placeholder="250" required="required"/>
                            </div>
                            <div class="apm-field">
                                <label>Expected Price (&#8377;) <span class="apm-req">*</span></label>
                                <input type="number" name="price" min="0" placeholder="17500000" required="required"/>
                            </div>
                        </div>

                        <div class="apm-section">Location Information</div>
                        <div class="apm-grid">
                            <div class="apm-field apm-full">
                                <label>Complete Address <span class="apm-req">*</span></label>
                                <input type="text" name="location" placeholder="Street address, building name, landmarks" required="required"/>
                            </div>
                            <div class="apm-field">
                                <label>Locality / Area <span class="apm-req">*</span></label>
                                <input type="text" name="place" placeholder="e.g., Jubilee Hills" required="required"/>
                            </div>
                            <div class="apm-field">
                                <label>City <span class="apm-req">*</span></label>
                                <input type="text" name="city" placeholder="e.g., Hyderabad" required="required"/>
                            </div>
                            <div class="apm-field">
                                <label>State <span class="apm-req">*</span></label>
                                <input type="text" name="state" placeholder="e.g., Telangana" required="required"/>
                            </div>
                        </div>

                        <div class="apm-section">Property Images</div>
                        <div class="apm-grid">
                            <div class="apm-field apm-full">
                                <input type="file" name="images" id="apmImages" accept="image/*" multiple="multiple" required="required"/>
                                <small>JPG / PNG / WEBP. The first image is used as the cover.</small>
                                <div class="apm-previews" id="apmPreviews"/>
                            </div>
                        </div>

                        <div class="apm-section">Property Owner Information</div>
                        <t t-set="apm_logged_in" t-value="not request.env.user._is_public()"/>
                        <div class="apm-grid">
                            <div class="apm-field">
                                <label>Owner Name <span class="apm-req">*</span></label>
                                <input type="text" name="customer_name" placeholder="Full legal name" required="required"
                                       t-att-value="request.env.user.partner_id.name if apm_logged_in else None"/>
                            </div>
                            <div class="apm-field">
                                <label>Phone Number <span class="apm-req">*</span></label>
                                <input type="tel" name="phone_number" placeholder="+91 98765 43210" required="required"
                                       t-att-value="request.env.user.partner_id.phone if apm_logged_in else None"/>
                            </div>
                            <div class="apm-field">
                                <label>Email <span class="apm-req">*</span></label>
                                <input type="email" name="email" placeholder="you@example.com" required="required"
                                       t-att-value="(request.env.user.partner_id.email or request.env.user.login) if apm_logged_in else None"
                                       t-att-readonly="'readonly' if apm_logged_in else None"/>
                                <small t-if="apm_logged_in">Linked to your account email.</small>
                            </div>
                        </div>

                        <div class="apm-submit-row">
                            <button type="submit" class="apm-submit" id="apmSubmit">
                                <i class="fa fa-paper-plane"/> Submit Property for Review
                            </button>
                            <p class="apm-note"><i class="fa fa-shield"/> Your information is secure and will be reviewed within 24 hours.</p>
                        </div>
                    </form>
                </div>
            </div>

            <script type="text/javascript">
                (function () {
                    var modal = document.getElementById('addPropertyModal');
                    if (!modal) return;
                    var openBtn = document.getElementById('openAddProperty');
                    var closeBtn = document.getElementById('apmClose');

                    function openModal() {
                        modal.classList.add('apm-open');
                        modal.setAttribute('aria-hidden', 'false');
                        document.body.classList.add('apm-lock');
                    }
                    function closeModal() {
                        modal.classList.remove('apm-open');
                        modal.setAttribute('aria-hidden', 'true');
                        document.body.classList.remove('apm-lock');
                    }

                    if (openBtn) openBtn.addEventListener('click', openModal);
                    if (closeBtn) closeBtn.addEventListener('click', closeModal);
                    // click on the dark area outside the panel closes it
                    modal.addEventListener('mousedown', function (e) {
                        if (e.target === modal) closeModal();
                    });
                    document.addEventListener('keydown', function (e) {
                        if (e.key === 'Escape') closeModal();
                    });
                    // /properties#add-property opens it straight away
                    if (window.location.hash === '#add-property') openModal();

                    // image previews
                    var files = document.getElementById('apmImages');
                    var box = document.getElementById('apmPreviews');
                    if (files &amp;&amp; box) {
                        files.addEventListener('change', function () {
                            box.innerHTML = '';
                            Array.prototype.forEach.call(files.files, function (f, i) {
                                if (!f.type || f.type.indexOf('image/') !== 0) return;
                                var reader = new FileReader();
                                reader.onload = function (e) {
                                    var d = document.createElement('div');
                                    d.className = 'apm-prev';
                                    var img = document.createElement('img');
                                    img.src = e.target.result;
                                    d.appendChild(img);
                                    if (i === 0) {
                                        var tag = document.createElement('span');
                                        tag.textContent = 'COVER';
                                        d.appendChild(tag);
                                    }
                                    box.appendChild(d);
                                };
                                reader.readAsDataURL(f);
                            });
                        });
                    }

                    // stop double submissions while images upload
                    var form = document.getElementById('apmForm');
                    var btn = document.getElementById('apmSubmit');
                    var sent = false;
                    if (form) {
                        form.addEventListener('submit', function (e) {
                            if (sent) { e.preventDefault(); return; }
                            sent = true;
                            if (btn) { btn.disabled = true; btn.textContent = 'Submitting...'; }
                        });
                    }
                })();
            </script>

        </main>


        </t>
    </template>
</odoo>