<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- HOME PAGE: filter bar + map + "N properties found" band -->
    <template id="property_map_template" name="Property Map Page">
        <t t-call="website.layout">

            <t t-set="head">
                <link rel="stylesheet" href="/real_estate_management/static/src/css/property_map.css"/>
                <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css"/>

                <style>
                    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&amp;family=Playfair+Display:ital,wght@0,700;0,800;1,700&amp;family=DM+Sans:wght@400;500;600;700;800&amp;family=Poppins:wght@400;500;600&amp;display=swap');

                    /* ⭐ LIGHT MODE: white background across the whole page root
                       so there are no dark gaps between sections. */
                    #home-page-root {
                        font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
                        background-color: #ffffff;
                        color: #111827;
                    }

                    /* ⭐ Single continuous paint region for every teal band
                       (pshowcase + legacy-band + home-categories + home-properties
                       + investment-overview + callback-band). Putting the color
                       on ONE wrapper instead of on each section individually
                       means there is only ever one background element — no
                       shared edge between two separately-painted elements, so
                       no seam/hairline can appear between them, regardless of
                       browser sub-pixel rounding. */
                    .teal-wrap { background: #e5e7eb; }
                    /* ⭐ Strip out any border/shadow/margin the Odoo website
                       theme's default section styling might be injecting —
                       that's what was actually rendering as a line at the
                       shared edge between two sections, not an anti-aliasing
                       quirk. Every section in this stack now inherits its
                       colour straight from .teal-wrap and carries nothing
                       else that could visually separate it from its neighbour. */
                    .teal-wrap > section {
                        background: transparent !important;
                        border: none !important;
                        border-top: none !important;
                        border-bottom: none !important;
                        box-shadow: none !important;
                        outline: none !important;
                        margin: 0 !important;
                    }

                    /* ============ EXCLUSIVE PROPERTY SHOWCASE (dashboard-style hero) ============ */
                    #pshowcase {
                        padding: 28px;
                    }
                    .ps-shell { display: flex; }
                    .ps-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 16px; }

                    /* light rounded search / filter bar */
                    .ps-topbar {
                        display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
                        background: #fdfcf9; border-radius: 18px; padding: 12px 18px;
                    }
                    .ps-search-box {
                        flex: 1 1 220px; display: flex; align-items: center; gap: 10px;
                        background: #fff; border: 1px solid #e9e7e1; border-radius: 12px; padding: 10px 14px;
                    }
                    .ps-search-box i { color: #9ca3af; font-size: 12px; }
                    .ps-search-box input {
                        border: none; outline: none; background: transparent; font-size: 13px; color: #111827;
                        width: 100%;
                    }
                    .ps-search-box input::placeholder { color: #9ca3af; }
                    .ps-topbar select, .ps-extra-select {
                        border: 1px solid #e9e7e1; border-radius: 10px; padding: 10px 14px; font-weight: 600;
                        font-size: 12.5px; color: #374151; background: #fff; cursor: pointer;
                    }
                    /* ===== Bigger dropdown lists (All Types / Cities / Price / Rating) ===== */
                    .ps-topbar select,
                    .ps-extra-select,
                    #citySelect {
                        font-size: 15px;
                        min-width: 150px;
                    }
                    .ps-topbar select option,
                    .ps-extra-select option,
                    #citySelect option {
                        font-size: 17px;
                        font-weight: 600;
                        line-height: 1.5;
                        padding: 12px 18px;
                        min-height: 44px;
                        background: #ffffff;
                        color: #1f2937;
                    }
                    .ps-topbar select option:checked,
                    .ps-extra-select option:checked,
                    #citySelect option:checked {
                        background: #fde8e8;
                        color: #b91c1c;
                    }
                    .ps-cta-group { display: flex; align-items: center; gap: 8px; }
                    .ps-cta-group a {
                        text-decoration: none; padding: 10px 16px; border-radius: 10px; font-weight: 700;
                        font-size: 12px; white-space: nowrap; transition: all 0.2s ease;
                    }
                    .ps-cta-group .ps-btn-primary { background: linear-gradient(135deg, #dc2626, #b91c1c); color: #fff; }
                    .ps-cta-group .ps-btn-primary:hover { transform: translateY(-2px); color: #fff; }
                    .ps-cta-group .ps-btn-ghost { border: 1.5px solid #e9e7e1; color: #374151; }
                    .ps-cta-group .ps-btn-ghost:hover { border-color: #9ca3af; color: #111827; }

                    /* small round theme-toggle icon, next to the CTA buttons */
                    .ps-theme-toggle {
                        width: 38px; height: 38px; border-radius: 50%; border: 1.5px solid #e9e7e1;
                        display: flex; align-items: center; justify-content: center; color: #374151;
                        cursor: pointer; flex: 0 0 auto; transition: all 0.2s ease;
                    }
                    .ps-theme-toggle:hover { border-color: #9ca3af; color: #111827; }
                    .ps-theme-toggle input { display: none; }

                    /* big rounded map card with floating stat pills */
                    .ps-map-card { position: relative; border-radius: 24px; overflow: hidden; background: #eef1ef; min-height: 500px; }
                    .ps-map-card #propertyMap { height: 100%; min-height: 500px; border-radius: 0; border: none; margin: 0; }
                    .ps-pill-stats {
                        position: absolute; top: 46%; left: 50%; transform: translate(-50%, -50%);
                        display: flex; gap: 10px; z-index: 500; pointer-events: none;
                    }
                    .ps-pill {
                        background: #111318; color: #fff; border-radius: 14px; padding: 14px 22px;
                        text-align: center; min-width: 100px; box-shadow: 0 14px 30px rgba(0,0,0,0.3);
                    }
                    .ps-pill .ps-pill-num { font-size: 21px; font-weight: 800; display: block; line-height: 1.2; }
                    .ps-pill .ps-pill-label { font-size: 9px; color: #9ca3af; text-transform: uppercase; letter-spacing: 0.4px; }
                    #category-legend.ps-legend {
                        position: absolute; bottom: 14px; left: 14px; z-index: 500; margin: 0; gap: 10px;
                        background: rgba(255,255,255,0.92); border-radius: 10px; padding: 6px 10px; display: flex; flex-wrap: wrap;
                    }

                    /* ⭐ Top-left floating panel: small cards for 5-star rated
                       properties, stacked on top of the map. */
                    .ps-five-star-panel {
                        position: absolute; top: 66px; left: 14px; z-index: 500;
                        display: flex; flex-direction: column; gap: 10px;
                        max-height: calc(100% - 140px); overflow-y: auto;
                        width: 230px;
                    }
                    .ps-five-star-panel.ps-hidden { display: none; }
                    .ps-fs-label {
                        display: inline-flex; align-items: center; gap: 6px;
                        background: rgba(17,19,24,0.85); color: #fff; font-size: 12px; font-weight: 800;
                        letter-spacing: 0.4px; text-transform: uppercase; border-radius: 999px;
                        padding: 7px 14px; width: fit-content;
                    }
                    .ps-fs-label i { color: #f5a623; font-size: 12px; }
                    .ps-fs-card {
                        display: flex; gap: 12px; text-decoration: none; color: inherit;
                        background: rgba(255,255,255,0.97); border-radius: 14px; padding: 10px;
                        box-shadow: 0 8px 22px rgba(0,0,0,0.2); border: 1px solid rgba(0,0,0,0.05);
                        transition: transform 0.15s ease, box-shadow 0.15s ease;
                    }
                    .ps-fs-card:hover { transform: translateY(-2px); box-shadow: 0 12px 26px rgba(0,0,0,0.28); }
                    .ps-fs-img { position: relative; width: 68px; height: 68px; flex: 0 0 auto; border-radius: 10px; overflow: hidden; background: #f3f4f6; }
                    .ps-fs-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
                    .ps-fs-body { min-width: 0; flex: 1; display: flex; flex-direction: column; justify-content: center; }
                    .ps-fs-name { font-size: 14px; font-weight: 700; color: #1f2937; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                    .ps-fs-price { font-size: 14px; font-weight: 800; color: #c7773a; margin-top: 2px; }
                    .ps-fs-stars { font-size: 11px; margin-top: 3px; }
                    .ps-fs-stars .fa-star { color: #f5a623; }
                    .ps-fs-stars .fa-star-o { color: #d1d5db; }
                    .ps-fs-view { font-size: 12px; font-weight: 700; color: #2563eb; margin-top: 4px; }

                    /* price-bubble markers on the map */
                    .ps-price-marker {
                        color: #fff; font-weight: 800; font-size: 12px; padding: 5px 10px; border-radius: 9999px;
                        box-shadow: 0 3px 10px rgba(0,0,0,0.25); border: 2px solid #fff; white-space: nowrap;
                    }


                    /* ============ WHITE BANDS (properties list + add property) ============ */
                    .ps-info-card { background: #fdfcf9; border-radius: 20px; padding: 20px; }
                    .ps-browse-panel { padding: 8px 4px 4px; background: transparent; }

                    /* ----- "N properties found" list ----- */
                    .ps-list-head { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; padding: 0 6px; }
                    .ps-count { font-weight: 800; font-size: 18px; color: #111827; }
                    .ps-hint { font-size: 12px; color: #6b7280; }

                    /* every property = one black card, ALL the same size.
                       Picture on the left (25%), text on the right (75%). */
                    .ps-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(640px, 1fr)); grid-auto-rows: 210px; gap: 20px; }
                    .ps-card {
                        display: flex; gap: 18px; height: 210px; box-sizing: border-box;
                        border: 1px solid rgba(255,255,255,0.10); border-radius: 18px; padding: 14px; overflow: hidden;
                        cursor: pointer; text-decoration: none; color: #f5efe0; background: #0b0b0d;
                        box-shadow: 0 10px 26px rgba(0,0,0,0.28);
                        transition: box-shadow 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
                    }
                    .ps-card:hover, .ps-card.ps-card-active { box-shadow: 0 16px 34px rgba(0,0,0,0.42); border-color: rgba(199,119,58,0.7); transform: translateY(-2px); }
                    .ps-card-img { position: relative; flex: 0 0 25%; height: 100%; border-radius: 14px; overflow: hidden; background: #33333a; }
                    .ps-card-img img { width: 100%; height: 100%; object-fit: cover; }
                    .ps-card-badge {
                        position: absolute; top: 8px; left: 8px; font-size: 9px; font-weight: 800; letter-spacing: 0.3px;
                        text-transform: uppercase; color: #fff; padding: 3px 7px; border-radius: 6px;
                    }
                    .ps-card-premium {
                        position: absolute; bottom: 8px; left: 8px; font-size: 9px; font-weight: 800; color: #92400e;
                        background: #fef3c7; padding: 3px 7px; border-radius: 6px;
                    }
                    .ps-card-body { flex: 1 1 75%; min-width: 0; display: flex; flex-direction: column; justify-content: center; }

                    /* TITLE: the headline of the card - bold Playfair Display in a gold gradient.
                       (max 2 lines so every card stays the same size) */
                    .ps-card-title {
                        font-family: 'Playfair Display', 'DM Serif Display', Georgia, serif; font-weight: 800;
                        font-size: clamp(27px, 2.5vw, 38px); line-height: 1.2; letter-spacing: 0.3px;
                        margin: 0 0 8px; padding: 2px 0 4px;
                        background: linear-gradient(135deg, #fbeabf 0%, #e0b25a 50%, #fbeabf 100%);
                        -webkit-background-clip: text; background-clip: text;
                        -webkit-text-fill-color: transparent; color: #f0cf8a;
                        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
                        overflow-wrap: anywhere;
                    }
                    /* property name: clearly smaller, right under the title */
                    .ps-card-name { font-size: 15px; font-weight: 600; letter-spacing: 0.3px; color: rgba(245,239,224,0.85); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                    .ps-card-price { font-weight: 800; font-size: 18px; color: #f5efe0; margin-top: 6px; }
                    .ps-card-loc { font-family: 'Poppins', 'DM Sans', sans-serif; font-weight: 500; font-size: 12px; letter-spacing: 0.1px; color: rgba(245,239,224,0.6); display: flex; align-items: center; gap: 5px; margin-top: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
                    .ps-card-loc i { color: #dc2626; font-size: 11px; flex: 0 0 auto; }
                    .ps-card-meta { display: flex; align-items: center; gap: 12px; margin-top: 6px; }
                    .ps-card-rating { font-size: 12px; }
                    .ps-card-rating .fa-star { color: #f5a623; }
                    .ps-card-rating .fa-star-o { color: rgba(245,239,224,0.35); }
                    .ps-card-type { font-size: 11px; font-weight: 700; text-transform: uppercase; }
                    /* QR on the right of every card: the same QR that is printed on that property's flier */
                    .ps-card-qr {
                        flex: 0 0 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;
                        gap: 8px; padding-left: 18px; border-left: 1px dashed rgba(255,255,255,0.18);
                    }
                    .ps-card-qr { cursor: pointer; }
                    .ps-card-qr:hover img { box-shadow: 0 0 0 3px rgba(224,178,90,0.85); }
                    .ps-card-qr img {
                        width: 124px; height: 124px; display: block; background: #fff; padding: 7px; border-radius: 12px;
                        box-sizing: border-box; object-fit: contain;
                    }
                    .ps-card-qr span { font-size: 10px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase; color: rgba(245,239,224,0.6); text-align: center; }
                    .ps-empty-list { padding: 20px; text-align: center; color: #9ca3af; font-size: 14px; grid-column: 1 / -1; }

                    /* ============ RESPONSIVE ============ */
                    @media (max-width: 992px) {
                        .ps-shell { flex-direction: column; }
                        .ps-map-card, .ps-map-card #propertyMap { min-height: 380px; }
                        .ps-pill { min-width: 76px; padding: 10px 12px; }
                        .ps-pill .ps-pill-num { font-size: 16px; }
                    }
                    @media (max-width: 600px) {
                        #pshowcase { padding: 16px; }
                        .ps-topbar { flex-direction: column; align-items: stretch; }
                        .ps-cta-group { justify-content: center; }
                        .ps-pill-stats { flex-wrap: wrap; justify-content: center; width: 90%; }
                        .ps-five-star-panel { width: 180px; top: 58px; max-height: calc(100% - 110px); }
                        .ps-fs-img { width: 52px; height: 52px; }
                        .ps-fs-name, .ps-fs-price { font-size: 12px; }
                        .ps-browse-panel { padding: 8px 0 0; }
                        .ps-cards { grid-template-columns: 1fr; }
                        .ps-card-img { flex-basis: 30%; }
                        .ps-card-qr { flex-basis: 96px; padding-left: 10px; }
                        .ps-card-qr img { width: 84px; height: 84px; }
                        .ps-card-title { font-size: 24px; }
                    }

                    /* ============ DARK THEME (kept sections) ============ */
#home-page-root[data-theme="dark"] {
                        background-color: #0b0b0d; color: #f5efe0;
                    }

                    /* ⭐ Dashboard-style hero (#pshowcase): every white/cream card
                       now flips to a dark card with light text when the theme
                       toggle is switched on. */
                    #home-page-root[data-theme="dark"] .ps-topbar {
                        background: #17171b;
                    }
                    #home-page-root[data-theme="dark"] .ps-search-box {
                        background: #1f1f24; border-color: rgba(255,255,255,0.12);
                    }
                    #home-page-root[data-theme="dark"] .ps-search-box input { color: #f5efe0; }
                    #home-page-root[data-theme="dark"] .ps-search-box input::placeholder { color: rgba(245,239,224,0.5); }
                    #home-page-root[data-theme="dark"] .ps-search-box i { color: rgba(245,239,224,0.5); }
                    #home-page-root[data-theme="dark"] .ps-topbar select,
                    #home-page-root[data-theme="dark"] .ps-extra-select {
                        background: #1f1f24; border-color: rgba(255,255,255,0.12); color: #f5efe0;
                    }
                    #home-page-root[data-theme="dark"] .ps-topbar select option,
                    #home-page-root[data-theme="dark"] .ps-extra-select option,
                    #home-page-root[data-theme="dark"] #citySelect option {
                        background: #1f1f24; color: #f5efe0;
                    }
                    #home-page-root[data-theme="dark"] .ps-topbar select option:checked,
                    #home-page-root[data-theme="dark"] .ps-extra-select option:checked,
                    #home-page-root[data-theme="dark"] #citySelect option:checked {
                        background: #3a2a1a; color: #f5a623;
                    }
                    #home-page-root[data-theme="dark"] .ps-cta-group .ps-btn-ghost {
                        border-color: rgba(255,255,255,0.18); color: #f5efe0;
                    }
                    #home-page-root[data-theme="dark"] .ps-cta-group .ps-btn-ghost:hover {
                        border-color: rgba(255,255,255,0.4); color: #ffffff;
                    }
                    #home-page-root[data-theme="dark"] .ps-theme-toggle {
                        border-color: rgba(255,255,255,0.18); color: #f5efe0;
                    }
                    #home-page-root[data-theme="dark"] .ps-theme-toggle:hover {
                        border-color: rgba(255,255,255,0.4); color: #ffffff;
                    }
                    #home-page-root[data-theme="dark"] .ps-map-card { background: #1f1f24; }
                    #home-page-root[data-theme="dark"] #category-legend.ps-legend {
                        background: rgba(20,20,23,0.92); color: #f5efe0;
                    }
                    #home-page-root[data-theme="dark"] .ps-fs-card {
                        background: rgba(23,23,27,0.97); border-color: rgba(255,255,255,0.08);
                    }
                    #home-page-root[data-theme="dark"] .ps-fs-img { background: #33333a; }
                    #home-page-root[data-theme="dark"] .ps-fs-name { color: #f5efe0; }
                    #home-page-root[data-theme="dark"] .ps-fs-price { color: #f3d9a4; }
                    #home-page-root[data-theme="dark"] .ps-fs-view { color: #93c5fd; }

                    #home-page-root[data-theme="dark"] .ps-empty-list { color: rgba(245,239,224,0.5); }
                </style>
            </t>

            <div id="wrap">
                <main class="container-fluid" id="home-page-root">

                    <div class="teal-wrap">
                    <section id="pshowcase">
                        <div class="ps-shell">
                            <div class="ps-main">

                                <!-- 1. search / filter bar -->
                                <form method="get" action="/" id="cityFilterForm" class="ps-topbar">
                                    <div class="ps-search-box">
                                        <i class="fas fa-magnifying-glass"/>
                                        <input type="text" id="psQuickSearch" placeholder="Search properties by name or locality..."/>
                                    </div>
                                    <select name="property_type" class="ps-extra-select" onchange="this.form.submit()">
                                        <option value="">All Types</option>
                                        <t t-foreach="categories" t-as="cat">
                                            <option t-att-value="cat.id" t-att-selected="'selected' if str(cat.id)==str(selected_category) else None"><t t-esc="cat.name"/></option>
                                        </t>
                                    </select>
                                    <select name="city" id="citySelect" onchange="this.form.submit()">
                                        <option value="">All Cities</option>
                                        <t t-foreach="city_list" t-as="city">
                                            <option t-att-value="city" t-att-selected="'selected' if city==selected_city else None"><t t-esc="city"/></option>
                                        </t>
                                    </select>
                                    <select name="price_range" class="ps-extra-select" onchange="this.form.submit()">
                                        <option value="">Any Price</option>
                                        <option value="under_50l" t-att-selected="'selected' if selected_price_band=='under_50l' else None">Under &#8377;50L</option>
                                        <option value="50l_1cr" t-att-selected="'selected' if selected_price_band=='50l_1cr' else None">&#8377;50L - &#8377;1Cr</option>
                                        <option value="1cr_2cr" t-att-selected="'selected' if selected_price_band=='1cr_2cr' else None">&#8377;1Cr - &#8377;2Cr</option>
                                        <option value="above_2cr" t-att-selected="'selected' if selected_price_band=='above_2cr' else None">Above &#8377;2Cr</option>
                                    </select>
                                    <select name="rating" class="ps-extra-select" onchange="this.form.submit()">
                                        <option value="" t-att-selected="'selected' if not selected_rating else None">Any Rating</option>
                                        <option value="5" t-att-selected="'selected' if selected_rating=='5' else None">5 Stars</option>
                                        <option value="4" t-att-selected="'selected' if selected_rating=='4' else None">4 Stars &amp; Up</option>
                                        <option value="3" t-att-selected="'selected' if selected_rating=='3' else None">3 Stars &amp; Up</option>
                                        <option value="2" t-att-selected="'selected' if selected_rating=='2' else None">2 Stars &amp; Up</option>
                                        <option value="1" t-att-selected="'selected' if selected_rating=='1' else None">1 Star &amp; Up</option>
                                    </select>
                                    <div class="ps-cta-group">
                                        <label class="ps-theme-toggle" title="Toggle theme">
                                            <input type="checkbox" id="themeSwitch"/>
                                            <i class="fas fa-circle-half-stroke"/>
                                        </label>
                                        <a href="/properties" class="ps-btn-ghost">Browse Full Listing</a>
                                    </div>
                                </form>

                                <div id="ai-ticker-anchor"/>

                                <!-- 2. the map -->
                                <div class="ps-map-card">
                                    <div id="propertyMap"/>
                                    <div id="property-data" t-att-data-properties="properties_json" style="display:none;"/>

                                    <div id="fiveStarPanel" class="ps-five-star-panel ps-hidden">
                                        <span class="ps-fs-label"><i class="fas fa-star"/>Top Rated</span>
                                        <div id="fiveStarCardsList"/>
                                    </div>

                                    <div class="ps-pill-stats">
                                        <div class="ps-pill">
                                            <span class="ps-pill-num" t-esc="property_count or 0"/>
                                            <span class="ps-pill-label">Properties</span>
                                        </div>
                                        <div class="ps-pill">
                                            <span class="ps-pill-num" t-esc="filtered_cities_count or 0"/>
                                            <span class="ps-pill-label">Cities</span>
                                        </div>
                                        <div class="ps-pill">
                                            <span class="ps-pill-num" t-esc="total_agents_count or 0"/>
                                            <span class="ps-pill-label">Agents</span>
                                        </div>
                                    </div>

                                    <div id="category-legend" class="ps-legend" t-att-data-colors="category_colors"/>
                                </div>

                                <!-- 3. white band: "N properties found" (cards drawn by property_map.js) -->
                                <div class="ps-browse-panel" id="psBrowsePanel">
                                    <div class="ps-list-head">
                                        <div class="ps-count"><t t-esc="property_count or 0"/> properties found</div>
                                        <div class="ps-hint">Click a card to see full details</div>
                                    </div>
                                    <div class="ps-cards" id="psCardsList">
                                        <div class="ps-empty-list">Loading properties…</div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <script>
                            (function () {
                                // quick text filter over the property cards
                                var input = document.getElementById('psQuickSearch');
                                if (input) {
                                    input.addEventListener('input', function () {
                                        var q = input.value.trim().toLowerCase();
                                        var cards = document.querySelectorAll('#psCardsList .ps-card');
                                        cards.forEach(function (card) {
                                            var text = card.textContent.toLowerCase();
                                            card.style.display = (!q || text.indexOf(q) !== -1) ? '' : 'none';
                                        });
                                    });
                                }
                            })();
                        </script>
