<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== TREE VIEW ==================== -->
    <record id="view_customer_registration_tree" model="ir.ui.view">
        <field name="name">customer.registration.tree</field>
        <field name="model">customer.registration</field>
        <field name="arch" type="xml">
            <list string="Customer Registrations"
                  decoration-info="status=='submitted'"
                  decoration-success="status=='approved'"
                  decoration-danger="status=='rejected'"
                  sample="1">
                <field name="name" string="Registration ID"/>
                <field name="customer_name" string="Customer Name"/>
                <field name="email"/>
                <field name="phone" string="Phone Number"/>
                <field name="city"/>
                <field name="interested_in"/>
                <field name="submission_date" string="Submitted On"/>
                <field name="status" widget="badge"
                       decoration-info="status=='submitted'"
                       decoration-success="status=='approved'"
                       decoration-danger="status=='rejected'"/>
            </list>
        </field>
    </record>

    <!-- ==================== FORM VIEW ==================== -->
    <record id="view_customer_registration_form" model="ir.ui.view">
        <field name="name">customer.registration.form</field>
        <field name="model">customer.registration</field>
        <field name="arch" type="xml">
            <form string="Customer Registration">
                <header>
                    <button name="action_approve"
                            string="✓ Approve &amp; Create Customer"
                            type="object"
                            class="oe_highlight"
                            invisible="status in ['approved', 'rejected']"
                            confirm="Are you sure you want to approve this customer registration? This will create a customer profile with portal access."/>

                    <button name="action_reject"
                            string="✗ Reject Registration"
                            type="object"
                            class="btn-danger"
                            invisible="status in ['approved', 'rejected']"/>

                    <button name="action_view_customer_profile"
                            string="👤 View Customer Profile"
                            type="object"
                            class="btn-info"
                            invisible="not partner_id"/>

                    <field name="status" widget="statusbar" statusbar_visible="submitted,approved"/>
                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_customer_profile"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-user"
                                invisible="not partner_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Customer Profile</span>
                            </div>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" class="o_text_overflow"/>
                        </h1>
                        <h2>
                            <field name="customer_name" placeholder="Enter Customer Full Name" required="1"/>
                        </h2>
                    </div>

                    <group>
                        <group string="📧 Contact Information">
                            <field name="email" widget="email" required="1"/>
                            <field name="phone" widget="phone" required="1"/>
                            <field name="interested_in"/>
                        </group>
                        <group string="📍 Location">
                            <field name="address"/>
                            <field name="city"/>
                            <field name="state_id" options="{'no_create': True, 'no_open': True}"/>
                            <field name="zip_code"/>
                            <field name="country_id" options="{'no_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <group>
                        <field name="notes" placeholder="Any additional requirements or notes..."/>
                    </group>

                    <group>
                        <group string="Submission">
                            <field name="submission_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="✅ Review Details" name="review"
                              invisible="status not in ['approved', 'rejected']">
                            <group>
                                <group string="Approval Information" invisible="status != 'approved'">
                                    <field name="reviewed_by" readonly="1"/>
                                    <field name="review_date" readonly="1"/>
                                    <field name="partner_id" readonly="1"/>
                                </group>
                                <group string="Rejection Information" invisible="status != 'rejected'">
                                    <field name="reviewed_by" readonly="1"/>
                                    <field name="review_date" readonly="1"/>
                                    <field name="rejection_reason" readonly="1" widget="text"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== SEARCH VIEW ==================== -->
    <record id="view_customer_registration_search" model="ir.ui.view">
        <field name="name">customer.registration.search</field>
        <field name="model">customer.registration</field>
        <field name="arch" type="xml">
            <search string="Search Customer Registrations">
                <field name="name" string="Registration ID"/>
                <field name="customer_name" string="Customer Name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="city"/>

                <separator/>
                <filter string="📥 Submitted" name="filter_submitted" domain="[('status', '=', 'submitted')]"/>
                <filter string="✅ Approved" name="filter_approved" domain="[('status', '=', 'approved')]"/>
                <filter string="❌ Rejected" name="filter_rejected" domain="[('status', '=', 'rejected')]"/>

                <separator/>
                <filter string="📅 This Month" name="filter_this_month"
                        domain="[('submission_date', '&gt;=', (context_today() - relativedelta(months=1)).strftime('%Y-%m-%d'))]"/>

                <group expand="0" string="Group By">
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_city" string="City" context="{'group_by': 'city'}"/>
                    <filter name="group_interest" string="Interested In" context="{'group_by': 'interested_in'}"/>
                    <filter name="group_submission_date" string="Submission Date"
                            context="{'group_by': 'submission_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ==================== ACTION ==================== -->
    <record id="action_customer_registration" model="ir.actions.act_window">
        <field name="name">Customer Registrations</field>
        <field name="res_model">customer.registration</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No customer registrations found!
            </p>
            <p>
                Customer registrations will appear here when submitted through the website.
            </p>
        </field>
    </record>

    <!-- ==================== MENU ==================== -->
    <menuitem id="menu_customer_registration"
              name="Customer Registrations"
              parent="menu_real_estate_root"
              action="action_customer_registration"
              sequence="30"/>

</odoo>
