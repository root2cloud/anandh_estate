    <!-- Action -->
    <record id="real_estate_management.action_property_management" model="ir.actions.act_window">
        <field name="name">Property Listings</field>
        <field name="res_model">property.property</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_property_search"/>
        <!-- ⭐ NEW: hides properties submitted by Agents that are still
             pending admin approval in "Property Submissions". Every other
             property (backend-created, or created via Customer approval)
             has is_agent_submission_approved = True by default, so this
             domain does not hide anything that was already visible. -->
        <field name="domain">[('is_agent_submission_approved', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No properties found. Let's create one!
            </p>
            <p>
                Add your first property listing to get started with real estate management.
            </p>
        </field>
    </record>

</odoo>