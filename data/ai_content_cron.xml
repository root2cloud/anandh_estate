<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">

        <!-- Scheduled action: runs nightly and generates AI content for any
             published property that doesn't have it yet. Processes a small
             batch per run (default 20) so a large catalog gets backfilled
             gradually across several nights instead of all at once, staying
             comfortably under the free-tier Gemini rate limit. -->
        <record id="ir_cron_generate_missing_ai_content" model="ir.cron">
            <field name="name">Real Estate: Generate Missing AI Content</field>
            <field name="model_id" ref="model_property_property"/>
            <field name="state">code</field>
            <field name="code">model._cron_generate_missing_ai_content()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

    </data>
</odoo>